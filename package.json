{
  "name": "saved-index",
  "private": true,
  "description": "AI-categorised library for Instagram saved posts: Chrome extension, backend and web app.",
  "type": "module",
  "workspaces": [
    "shared",
    "extension",
    "supabase",
    "web"
  ],
  "scripts": {
    "app": "npm install && npm run build && npm run dev:web",
    "deploy": "node scripts/deploy.mjs",
    "build": "npm run build -w extension",
    "watch": "npm run watch -w extension",
    "typecheck": "npm run typecheck --workspaces",
    "verify": "npm run verify -w extension",
    "build:functions": "npm run build -w supabase",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "eval": "npm run eval -w supabase --"
  }
}
