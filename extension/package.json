{
  "name": "@saved-index/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension: captures Instagram saved posts and adds real seek controls to Instagram videos.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p .",
    "verify": "esbuild tools/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=error && node node_modules/.cache/verify.mjs",
    "icons": "node tools/make-icons.mjs"
  },
  "dependencies": {
    "@saved-index/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
